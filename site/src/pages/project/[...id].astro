---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((entry) => !entry.data.draft);
  return projects.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'projects'> };
const { Content } = await render(entry);
const title = entry.data.seoTitle ?? entry.data.title;
const description = entry.data.seoDescription ?? entry.data.description;
---
<ContentLayout title={title} description={description} canonicalPath={entry.data.canonicalUrl ?? `/project/${entry.id}/`} type="project" publishedAt={entry.data.publishedAt} updatedAt={entry.data.updatedAt} image={entry.data.cover} tags={entry.data.tags} noindex={entry.data.noindex}>
  <article>
    <header class="page-head project-hero"><div class="shell"><p class="eyebrow">Project · {entry.data.year}</p><h1>{entry.data.title}</h1><p>{entry.data.description}</p><div class="case-meta-panel"><div><span>Client</span><strong>{entry.data.client}</strong></div><div><span>Scope</span><strong>{entry.data.services.join(' / ')}</strong></div><div><span>Outcome</span><strong>{entry.data.outcome ?? '문제 정의부터 구현까지 이어진 작업 기록'}</strong></div></div></div></header>
    <div class="content"><div class="shell prose case-study"><p class="meta">{entry.data.client} · {entry.data.services.join(' / ')}</p><Content /><a class="back" href="/project/">← 과제 목록</a></div></div>
  </article>
</ContentLayout>