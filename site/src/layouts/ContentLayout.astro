---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  type?: 'website' | 'article' | 'project';
  publishedAt?: Date;
  updatedAt?: Date;
  image?: string;
  tags?: string[];
  noindex?: boolean;
  eyebrow?: string;
}

const {
  title,
  description,
  canonicalPath,
  type = 'website',
  publishedAt,
  updatedAt,
  image,
  tags = [],
  noindex = false,
  eyebrow = 'Pulda',
} = Astro.props;
const baseUrl = Astro.site ?? new URL(import.meta.env.PUBLIC_SITE_URL || 'https://example.com');
const canonicalUrl = new URL(canonicalPath, baseUrl);
const imageUrl = image ? new URL(image, baseUrl) : undefined;
const pageTitle = `${title} | 풀다`;
const schema = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: publishedAt?.toISOString(),
      dateModified: (updatedAt ?? publishedAt)?.toISOString(),
      author: { '@type': 'Organization', name: '풀다' },
      publisher: { '@type': 'Organization', name: '풀다' },
      mainEntityOfPage: canonicalUrl.toString(),
      image: imageUrl?.toString(),
      keywords: tags.join(', '),
    }
  : type === 'project'
    ? {
        '@context': 'https://schema.org',
        '@type': 'CreativeWork',
        name: title,
        description,
        datePublished: publishedAt?.toISOString(),
        url: canonicalUrl.toString(),
        image: imageUrl?.toString(),
        creator: { '@type': 'Organization', name: '풀다' },
        keywords: tags.join(', '),
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: title,
        description,
        url: canonicalUrl.toString(),
      };
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <script is:inline>
    try {
      const stored = localStorage.getItem('pulda-theme');
      const theme = stored === 'dark' || stored === 'light'
        ? stored
        : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
    } catch (error) {}
  </script>
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'}>
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:locale" content="ko_KR">
  <meta property="og:site_name" content="풀다">
  <meta property="og:type" content={type === 'article' ? 'article' : 'website'}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  {imageUrl && <meta property="og:image" content={imageUrl}>}
  <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'}>
  <meta name="theme-color" content="#f4ead8" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#050914" media="(prefers-color-scheme: dark)">
  {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()}>}
  {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()}>}
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700;800&family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@700&display=swap" rel="stylesheet">
  <style is:global>
    :root{--max:1180px;--pad:clamp(20px,5vw,64px)}
    .shell{width:min(100%,var(--max));margin:auto;padding-inline:var(--pad)}
    main{min-height:70vh}
    .page-head{position:relative;padding:clamp(122px,12vw,176px) 0 72px;border-bottom:1px solid var(--line);overflow:hidden}.page-head:after{content:"";position:absolute;right:clamp(-60px,2vw,28px);bottom:22px;width:clamp(260px,26vw,420px);aspect-ratio:1.7/1;background:rgba(var(--red-rgb),.09);-webkit-mask:url("/logo/pulda-logo-red.webp") center/contain no-repeat;mask:url("/logo/pulda-logo-red.webp") center/contain no-repeat;pointer-events:none}.page-head h1{position:relative;max-width:900px;margin:0 0 28px;font-family:"Solmoe Kim Daegeon","Noto Serif KR",serif;font-size:clamp(46px,7vw,92px);font-weight:500;line-height:1.22;letter-spacing:0;word-break:keep-all;padding-top:.08em}.page-head p{position:relative;max-width:720px;margin:0;font-size:18px;word-break:keep-all}
    .content{padding:72px 0 128px}.section-grid{display:grid;grid-template-columns:minmax(180px,.8fr) minmax(0,1.6fr);gap:clamp(28px,5vw,76px);align-items:start}.panel{border-top:1px solid var(--line);padding-top:26px}.panel h2{margin:0 0 16px;font-size:clamp(28px,3.2vw,44px);line-height:1.18;word-break:keep-all}.panel p{margin:0 0 18px;font-size:18px;word-break:keep-all}.pill-list{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.pill{border:1px solid rgba(var(--red-rgb),.45);padding:7px 10px;color:var(--red);font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
    .content-list{border-top:1px solid var(--line)}.content-item{display:grid;grid-template-columns:140px 1fr auto;gap:28px;padding:34px 0;border-bottom:1px solid var(--line);align-items:start;transition:.22s}.content-item:hover{padding-inline:14px;background:rgba(var(--paper-rgb),.38)}.content-item time,.meta{font-size:12px;color:rgba(var(--navy-rgb),.66)}.content-item h2{margin:0 0 8px;font-size:clamp(20px,2vw,28px);word-break:keep-all}.content-item p{margin:0;font-size:14px;word-break:keep-all}
    .project-item .outcome{margin-top:10px;font-size:12px;color:rgba(var(--navy-rgb),.72)}.project-item .tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}.project-item .tag-pill{padding:3px 8px;border:1px solid rgba(var(--red-rgb),.3);color:var(--red);font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
    .story-feature{display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--line)}.story-feature-copy{display:flex;flex-direction:column;justify-content:flex-end;padding:48px;min-height:460px}.story-feature img{width:100%;height:100%;object-fit:cover;min-height:380px;display:block}.story-card-list{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-bottom:1px solid var(--line)}.story-card{display:grid;grid-template-columns:160px minmax(0,1fr);border-right:1px solid var(--line)}.story-card:last-child{border-right:0}.story-card img{width:100%;height:100%;object-fit:cover;min-height:260px;display:block}.story-card-copy{padding:32px 28px;display:flex;flex-direction:column;justify-content:space-between}.story-card p{margin:10px 0 0;font-size:14px;color:rgba(var(--navy-rgb),.72)}.related-story-list{display:grid;grid-template-columns:repeat(2,1fr);gap:0}.related-story-list .content-item{grid-template-columns:1fr}.story-principle-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(24px,3vw,48px);margin-top:32px}.prose p{margin:0 0 22px;font-size:17px;line-height:1.8;word-break:keep-all}.prose h2{margin:48px 0 20px;font-size:clamp(22px,2.4vw,32px)}.prose h3{margin:32px 0 14px;font-size:clamp(18px,1.8vw,24px)}.prose ul,.prose ol{margin:0 0 22px;padding-left:22px}.prose li{margin-bottom:8px;font-size:17px;line-height:1.8}.prose blockquote{margin:32px 0;padding:20px 28px;border-left:3px solid var(--red);background:rgba(var(--red-rgb),.06)}.prose blockquote p{margin:0;font-style:italic}.prose a{color:var(--red);text-decoration:underline;text-underline-offset:3px}.case-meta-panel{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin:48px 0;background:var(--line)}.case-meta-panel div{padding:24px 28px;background:var(--paper)}.case-meta-panel h3{margin:0 0 8px;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(var(--navy-rgb),.58)}.case-meta-panel p{margin:0;font-size:14px;font-weight:600}.back{display:inline-flex;align-items:center;gap:8px;margin-bottom:48px;padding:10px 18px;border:1px solid var(--line);font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;transition:.2s}.back:hover{border-color:var(--red);color:var(--red)}
    html[data-theme="dark"] .page-head{border-color:rgba(237,244,255,.12);background:linear-gradient(120deg,rgba(5,9,20,.96),rgba(7,13,26,.88))}html[data-theme="dark"] .page-head:after{background:linear-gradient(135deg,rgba(var(--tech-red-rgb),.18),rgba(125,220,255,.08));-webkit-mask:none;mask:none;clip-path:polygon(30% 0,100% 0,74% 100%,0 100%);box-shadow:0 0 38px rgba(var(--tech-red-rgb),.18)}html[data-theme="dark"] .page-head h1{font-family:"Hanken Grotesk","Noto Sans KR",sans-serif;font-weight:800;text-transform:uppercase;letter-spacing:0;color:var(--tech-white);text-shadow:0 0 32px rgba(var(--tech-red-rgb),.18)}html[data-theme="dark"] .page-head p,html[data-theme="dark"] .prose p,html[data-theme="dark"] .prose li{color:rgba(237,244,255,.76)}html[data-theme="dark"] .content-item:hover{background:rgba(var(--tech-red-rgb),.08);box-shadow:inset 3px 0 0 var(--tech-red)}html[data-theme="dark"] .content-item time,html[data-theme="dark"] .meta{color:rgba(237,244,255,.62)}html[data-theme="dark"] .project-item .outcome{color:rgba(237,244,255,.68)}html[data-theme="dark"] .case-meta-panel{background:rgba(237,244,255,.14);border-color:rgba(237,244,255,.14)}html[data-theme="dark"] .case-meta-panel div{background:rgba(237,244,255,.045)}html[data-theme="dark"] .pill{border-color:rgba(var(--tech-red-rgb),.5);color:var(--tech-red);box-shadow:0 0 12px rgba(var(--tech-red-rgb),.14)}html[data-theme="dark"] .back{border-color:rgba(237,244,255,.22);color:rgba(237,244,255,.72)}html[data-theme="dark"] .back:hover{border-color:var(--tech-red);color:var(--tech-red)}html[data-theme="dark"] .prose blockquote{border-color:var(--tech-red);background:rgba(var(--tech-red-rgb),.08)}html[data-theme="dark"] .story-card p{color:rgba(237,244,255,.68)}
    @media(max-width:820px){.section-grid{grid-template-columns:1fr}.content-item{grid-template-columns:1fr auto}.content-item time{grid-column:1/-1}.page-head{padding-top:120px}}
    @media(max-width:720px){.story-feature,.story-card-list,.related-story-list{grid-template-columns:1fr}.story-feature-copy{min-height:auto}.story-feature img{min-height:300px}.story-card{grid-template-columns:120px minmax(0,1fr)}.story-principle-grid{grid-template-columns:1fr}.project-list .content-item,.story-list .content-item{grid-template-columns:1fr}.story-list .content-item time{grid-column:1;grid-row:auto;justify-self:start}.case-meta-panel{grid-template-columns:1fr}}
    @media(max-width:520px){.story-card{grid-template-columns:1fr}.story-card img{min-height:220px}.page-head h1{font-size:42px;line-height:1.24}.page-head:after{width:260px;opacity:.72}.content{padding-bottom:96px}.content-item:hover{padding-inline:0}}
  </style>
</head>
<body>
  <SiteHeader />
  <main><slot /></main>
  <SiteFooter />
</body>
</html>
