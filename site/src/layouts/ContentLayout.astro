    .case-before-after{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;margin:40px 0 76px;background:var(--line);border:1px solid var(--line)}.before-panel,.after-panel{min-width:0;padding:clamp(22px,3vw,34px);background:var(--paper)}.before-panel h2,.after-panel h2{margin:0 0 18px;font-size:clamp(22px,2.4vw,32px);line-height:1.22}.before-panel ul,.after-panel ul{margin:0;padding-left:20px}.before-panel li,.after-panel li{font-size:15px;line-height:1.72}.device-showcase,.device-resolution-showcase{display:grid;grid-template-columns:minmax(0,.86fr) minmax(0,1.14fr);gap:clamp(24px,4vw,48px);align-items:start;margin:48px 0 76px}.device-copy{position:sticky;top:112px;min-width:0}.case-label{margin:0 0 10px;color:var(--red);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.device-copy h2{margin:0 0 18px;font-size:clamp(24px,2.8vw,38px);line-height:1.18}.device-copy p{margin-bottom:0}.screen-pair,.device-frames{display:grid;grid-template-columns:1fr 1fr;gap:16px;min-width:0}.screen-pair figure,.device-frame{margin:0;border:1px solid var(--line);background:rgba(var(--paper-rgb),.6);overflow:hidden}.screen-pair img,.device-frame img{display:block;width:100%;height:clamp(220px,28vw,380px);object-fit:contain;object-position:top;background:rgba(var(--paper-rgb),.68)}.screen-pair figcaption,.device-frame figcaption,.magazine-card figcaption{display:block;padding:13px 15px;border-top:1px solid var(--line);font-size:12px;line-height:1.45;color:rgba(var(--navy-rgb),.68)}.device-frame.desktop{grid-column:1/-1}.device-frame.mobile img{height:clamp(240px,30vw,420px)}.slide-card-strip{display:grid;grid-template-columns:1.16fr .92fr .92fr;gap:16px;margin:40px 0 76px}.slide-card{display:grid;grid-template-rows:auto 1fr;margin:0;border:1px solid var(--line);background:rgba(var(--paper-rgb),.58);overflow:hidden}.slide-card img{display:block;width:100%;height:clamp(190px,22vw,300px);object-fit:contain;object-position:top;background:rgba(var(--paper-rgb),.68)}.slide-card.feature img{height:clamp(230px,28vw,360px)}.slide-card div{padding:18px 20px}.slide-card span{display:block;margin-bottom:8px;color:var(--red);font-size:11px;font-weight:800;letter-spacing:.12em}.slide-card h3{margin:0 0 8px;font-size:clamp(18px,1.8vw,24px)}.slide-card p{margin:0;font-size:14px;line-height:1.62;color:rgba(var(--navy-rgb),.68)}.magazine-board,.deliverable-wall,.result-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:40px 0 76px}.magazine-card,.deliverable-wall article,.result-metrics div{margin:0;border:1px solid var(--line);background:rgba(var(--paper-rgb),.58);overflow:hidden}.magazine-card.wide{grid-column:1/-1}.magazine-card img{display:block;width:100%;height:clamp(220px,28vw,360px);object-fit:contain;object-position:top;background:rgba(var(--paper-rgb),.68)}.magazine-card.wide img{height:clamp(260px,34vw,420px)}.magazine-card.tall img{height:clamp(280px,38vw,460px)}.magazine-card figcaption strong{display:block;margin-bottom:4px;color:var(--navy);font-size:12px;text-transform:uppercase;letter-spacing:.08em}.magazine-card figcaption span{display:block}.deliverable-wall article,.result-metrics div{padding:22px 24px}.deliverable-wall span{display:block;margin-bottom:10px;color:var(--red);font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.deliverable-wall h3{margin:0 0 8px;font-size:clamp(18px,1.8vw,24px)}.deliverable-wall p{margin:0;font-size:14px;color:rgba(var(--navy-rgb),.68)}.result-metrics strong{display:block;margin-bottom:8px;color:var(--red);font-size:clamp(36px,5vw,64px);line-height:1}.result-metrics span{font-size:14px}.system-flow{display:grid;grid-template-columns:1fr 28px 1fr 28px 1fr 28px 1fr;gap:0;align-items:stretch;margin:40px 0 76px}.system-flow div{padding:20px;border:1px solid var(--line);background:rgba(var(--paper-rgb),.58)}.system-flow strong,.system-flow span{display:block}.system-flow strong{margin-bottom:6px}.system-flow span{font-size:13px;color:rgba(var(--navy-rgb),.66)}.system-flow i{position:relative;display:block}.system-flow i:before{content:"";position:absolute;left:50%;top:50%;width:10px;height:10px;border-right:2px solid var(--red);border-bottom:2px solid var(--red);transform:translate(-65%,-50%) rotate(-45deg)}
    /* 2026-07-11: capture slots reserve stable positions for user-supplied screenshots without broken image placeholders. */
    .capture-slot-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:40px 0 76px}.capture-slot{min-height:220px;padding:22px 24px;border:1px dashed rgba(var(--red-rgb),.45);background:linear-gradient(135deg,rgba(var(--paper-rgb),.82),rgba(var(--red-rgb),.06));display:flex;flex-direction:column;justify-content:flex-end}.capture-slot span{display:block;margin-bottom:10px;color:var(--red);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.capture-slot strong{display:block;margin-bottom:8px;font-size:clamp(18px,1.8vw,24px);line-height:1.32}.capture-slot p{margin:0 0 12px;font-size:14px;line-height:1.62;color:rgba(var(--navy-rgb),.68)}.capture-slot small{display:block;font-size:12px;line-height:1.5;color:rgba(var(--navy-rgb),.52)}
    .design-tokens{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;margin:24px 0 56px;background:var(--line);border:1px solid var(--line)}.design-tokens>div{padding:14px;background:var(--paper)}.design-tokens span{display:block;height:86px;margin-bottom:12px;background:var(--swatch);border:1px solid rgba(var(--navy-rgb),.16)}.design-tokens strong,.design-tokens small{display:block}.design-tokens strong{font-size:13px}.design-tokens small{margin-top:4px;font-size:12px;color:rgba(var(--navy-rgb),.58)}.heritage-reference{display:grid;grid-template-columns:minmax(260px,.9fr) 1fr;gap:1px;margin:28px 0 56px;background:var(--line);border:1px solid var(--line)}.heritage-reference>div{background:var(--paper);padding:24px}.heritage-flag-card{position:relative;min-height:280px;overflow:hidden;background:linear-gradient(135deg,#efe1ca,#fbf4e7 46%,#d7c2a2);isolation:isolate}.heritage-flag-card:before{content:"";position:absolute;inset:22px;border:1px solid rgba(var(--navy-rgb),.16)}.heritage-stain{position:absolute;border-radius:999px;background:rgba(122,76,38,.22);filter:blur(10px)}.stain-a{width:150px;height:110px;left:22px;top:22px}.stain-b{width:190px;height:150px;right:-44px;bottom:-28px}.heritage-taegeuk{position:absolute;width:130px;height:130px;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-35deg);border-radius:50%;background:linear-gradient(90deg,#8a5a31 0 50%,#13233a 50%)}.heritage-taegeuk:before,.heritage-taegeuk:after{content:"";position:absolute;left:50%;width:65px;height:65px;border-radius:50%;transform:translateX(-50%)}.heritage-taegeuk:before{top:0;background:#13233a}.heritage-taegeuk:after{bottom:0;background:#8a5a31}.heritage-trigram{position:absolute;width:52px;height:38px;background:repeating-linear-gradient(to bottom,#171717 0 7px,transparent 7px 15px)}.trigram-a{left:42px;top:42px;transform:rotate(-12deg)}.trigram-b{right:42px;top:42px;transform:rotate(12deg)}.trigram-c{left:42px;bottom:42px;transform:rotate(12deg)}.trigram-d{right:42px;bottom:42px;transform:rotate(-12deg)}
    /* 2026-07-06: animated miniature hero captures explain the light/dark shader intent without heavy GIF/video assets. */
    .hero-motion-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:36px 0 72px}.hero-motion-card{position:relative;min-height:360px;border:1px solid var(--line);background:rgba(var(--paper-rgb),.56);overflow:hidden}.hero-motion-card img{display:block;width:100%;height:100%;min-height:360px;object-fit:cover;object-position:top}.hero-motion-card:before,.hero-motion-card:after{content:"";position:absolute;inset:0;pointer-events:none}.hero-motion-card:before{mix-blend-mode:multiply;opacity:.58}.hero-motion-card.light:before{background:linear-gradient(96deg,transparent 28%,rgba(159,58,50,.08) 42%,rgba(159,58,50,.30) 56%,rgba(159,58,50,.12) 70%,transparent 86%);filter:blur(10px);animation:silkThreadDrift 4.8s ease-in-out infinite}.hero-motion-card.light:after{top:38%;height:30%;background:repeating-linear-gradient(172deg,transparent 0 18px,rgba(159,58,50,.26) 19px 21px,transparent 22px 44px);filter:blur(6px);opacity:.42;animation:silkThreadPull 5.8s ease-in-out infinite}.hero-motion-card.dark:before{background:linear-gradient(96deg,transparent 32%,rgba(255,45,45,.12) 46%,rgba(255,155,61,.72) 56%,rgba(125,220,255,.14) 68%,transparent 86%);filter:blur(8px);mix-blend-mode:screen;opacity:.9;animation:neonThreadSearch 3.9s ease-in-out infinite}.hero-motion-card.dark:after{background:radial-gradient(circle at 56% 50%,rgba(255,45,45,.48),transparent 13%),linear-gradient(90deg,transparent 0 42%,rgba(255,45,45,.52) 50%,rgba(255,155,61,.32) 58%,transparent 72%);mix-blend-mode:screen;filter:blur(16px);opacity:.72;animation:neonThreadPulse 2.8s ease-in-out infinite}.hero-motion-caption{position:absolute;left:18px;right:18px;bottom:18px;z-index:1;display:grid;gap:5px;padding:14px 16px;background:rgba(var(--paper-rgb),.82);border:1px solid rgba(var(--navy-rgb),.16);backdrop-filter:blur(10px)}.hero-motion-card.dark .hero-motion-caption{background:rgba(5,9,20,.74);border-color:rgba(237,244,255,.16);color:var(--tech-white)}.hero-motion-caption strong{font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--red)}.hero-motion-caption span{font-size:13px;line-height:1.45}@keyframes silkThreadDrift{0%,100%{transform:translateX(-6%) scaleX(.92)}50%{transform:translateX(7%) scaleX(1.08)}}@keyframes silkThreadPull{0%,100%{transform:translateX(-10%) translateY(-4px) rotate(-1deg)}50%{transform:translateX(9%) translateY(5px) rotate(1.2deg)}}@keyframes neonThreadSearch{0%,100%{transform:translateX(-8%) scaleX(.92);opacity:.62}50%{transform:translateX(10%) scaleX(1.12);opacity:1}}@keyframes neonThreadPulse{0%,100%{transform:scale(.96);opacity:.48}50%{transform:scale(1.08);opacity:.86}}html[data-theme="dark"] .hero-motion-card{background:rgba(237,244,255,.045);border-color:rgba(237,244,255,.14)}html[data-theme="dark"] .hero-motion-card.light .hero-motion-caption{background:rgba(237,244,255,.08);border-color:rgba(237,244,255,.16);color:var(--tech-white)}
