.partners{position:relative;padding-block:clamp(58px,7vw,104px);border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(var(--paper-rgb),.34)}.partner-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:28px}.partner-head p{max-width:430px;margin:0;color:rgba(var(--navy-rgb),.68);word-break:keep-all}.partner-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1px solid rgba(var(--navy-rgb),.18);background:rgba(var(--navy-rgb),.18)}.partner-logo{position:relative;min-height:118px;display:flex;align-items:center;justify-content:center;padding:26px 18px;background:rgba(var(--paper-rgb),.54);color:#111;font-size:clamp(18px,2.4vw,34px);font-weight:900;letter-spacing:.08em;text-transform:uppercase;filter:grayscale(1);overflow:hidden}.partner-logo:before{content:attr(data-trigram);position:absolute;left:14px;top:10px;color:rgba(17,17,17,.18);font-size:18px;letter-spacing:0}.partner-logo:after{content:"";position:absolute;left:18%;right:18%;bottom:18px;height:2px;background:#111;opacity:.22;transform:rotate(-1deg)}.partner-logo span{position:relative;z-index:1;text-align:center;line-height:1}.partner-note{margin:18px 0 0;color:rgba(var(--navy-rgb),.58);font-size:13px}.partner-note strong{color:var(--red)}.services{--red:var(--red-on-dark);--red-rgb:var(--red-on-dark-rgb);background:var(--navy);color:var(--white)}.section-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:64px}.section-head>p{max-width:430px;margin:0}.service-list{border-top:1px solid rgba(var(--paper-rgb),.22)}.service{display:grid;grid-template-columns:80px 1fr 1fr 48px;gap:24px;align-items:center;min-height:150px;border-bottom:1px solid rgba(var(--paper-rgb),.22);transition:.25s}.service:hover{padding-inline:20px;background:var(--navy2)}.num{color:var(--red);font-size:13px;font-weight:700}.service h3{margin:0;font-size:clamp(26px,3vw,42px);line-height:1.1}.service p{max-width:480px;margi