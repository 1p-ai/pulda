---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getStoryPath } from '../../utils/contentRoutes';

export async function getStaticPaths() {
  const stories = (await getCollection('stories')).filter((entry) => !entry.data.draft);
  return stories.map((entry) => ({ params: { id: entry.id.replace(/\.mdx?$/i, '') }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'stories'> };
const { Content } = await render(entry);
const title = entry.data.seoTitle ?? entry.data.title;
const description = entry.data.seoDescription ?? entry.data.description;
const dateFormatter = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'long' });
const relatedStories = (await getCollection('stories'))
  .filter((story) => !story.data.draft && story.id !== entry.id)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---
<ContentLayout title={title} description={description} canonicalPath={entry.data.canonicalUrl ?? getStoryPath(entry.id)} type="article" publishedAt={entry.data.publishedAt} updatedAt={entry.data.updatedAt} image={entry.data.cover} tags={entry.data.tags} noindex={entry.data.noindex}>
  <article>
    <section class="page-head story-article-head"><div class="shell"><p class="eyebrow">{entry.data.category}</p><h1>{entry.data.title}</h1><p>{entry.data.description}</p><p class="meta">{dateFormatter.format(entry.data.publishedAt)} · {entry.data.author}</p></div></section>
    <div class="content"><div class="shell prose story-prose">{entry.data.cover && <figure class="story-cover"><img src={entry.data.cover} alt={entry.data.title + ' 대표 이미지'} loading="eager" /><figcaption>{entry.data.title}</figcaption></figure>}<Content /><a class="back" href="/story/">← 이야기 목록</a></div></div>
    {relatedStories.length > 0 && <aside class="story-related"><div class="shell"><div class="story-section-title"><p class="case-label">More Stories</p><h2>이어 읽기</h2></div><div class="related-story-list">{relatedStories.map((story) => <a href={getStoryPath(story.id)}><span>{story.data.category}</span><strong>{story.data.title}</strong><p>{story.data.description}</p></a>)}</div></div></aside>}
  </article>
</ContentLayout>
