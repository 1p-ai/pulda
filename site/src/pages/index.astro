.button,.cta{min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:14px;padding:0 22px;border:2px solid var(--navy);background:var(--navy);color:var(--white);font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;transition:.2s}.button:hover,.cta:hover{border-color:var(--red);background:var(--red);color:var(--white)}.button.outline{background:transparent;color:var(--navy)}.button.outline:hover{color:var(--white)}.arrow{font-size:18px}.menu{position:relative;display:none;width:58px;height:48px;padding:0;border:0;background:none;cursor:pointer}.menu:before{content:"";position:absolute;inset:0;background:url("/logo/fan-menu-closed.png") center/48px auto no-repeat;transition:transform .22s ease,opacity .22s ease}.menu span{display:none}html:not([data-theme="dark"]) .menu:before{transform:rotate(-22deg) scale(.94);transform-origin:50% 58%;transition:transform .34s cubic-bezier(.2,.8,.2,1),filter .22s ease}html:not([data-theme="dark"]) .menu-open .menu:before{background-image:url("/logo/fan-menu-open.png");background-size:52px auto;transform:translateY(1px) rotate(23deg) scale(1)}html:not([data-theme="dark"]) body.fan-opening .menu:before{animation:fanOpenSpin .42s cubic-bezier(.2,.84,.18,1)}html:not([data-theme="dark"]) body.fan-closing .menu:before{animation:fanCloseSpin .38s cubic-bezier(.32,0,.2,1)}.menu-open .menu:before{background-image:url("/logo/fan-menu-open.png");background-size:52px auto;transform:translateY(1px)}@keyframes fanOpenSpin{0%{transform:rotate(-22deg) scale(.94)}58%{transform:rotate(31deg) scale(1.04)}100%{transform:translateY(1px) rotate(23deg) scale(1)}}@keyframes fanCloseSpin{0%{transform:translateY(1px) rotate(23deg) scale(1)}48%{transform:rotate(-34deg) scale(1.02)}100%{transform:rotate(-22deg) scale(.94)}}
