ody{clip-path:inset(0 0 43% 0)}.scroll-tassel{clip-path:inset(52% 0 0 0);transform-origin:50% 52%;animation:norigaeTassel 2.2s ease-in-out infinite}.scroll-label{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}@keyframes norigaeFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(9px)}}@keyframes norigaeTassel{0%,100%{transform:rotate(-1.8deg) translateY(0)}50%{transform:rotate(2.4deg) translateY(3px)}}@keyframes scrollChevron{0%,100%{opacity:.28;transform:translate(-50%,-3px) rotate(45deg)}45%{opacity:.82;transform:translate(-50%,7px) rotate(45deg)}}
