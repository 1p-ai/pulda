import ContentLayout from '../layouts/ContentLayout.astro';
---
<ContentLayout title="소개" description="풀다는 복잡한 비즈니스 문제를 명확한 전략, 디자인, 기술로 풀어내는 팀입니다." canonicalPath="/about/" eyebrow="About Pulda">
  <section class="page-head"><div class="shell"><p class="eyebrow"><span class="light-copy">풀다의 철학</span><span class="dark-copy">Operating Logic</span></p><h1><span class="light-copy">어려움을 풀고<br>올바름을 향합니다.</span><span class="dark-copy">System<br>Intelligence.</span></h1><p><span class="light-copy">풀다는 문제를 더 크게 포장하기보다 핵심을 발견하고, 불필요한 것을 덜어내고, 실행 가능한 방향으로 정리합니다.</span><span class="dark-copy">Pulda translates business complexity into structured decisions, resilient interfaces, and deployable systems.</span></p></div></section>
  <section class="content"><div class="shell section-grid"><aside><p class="eyebrow"><span class="light-copy">기준</span><span class="dark-copy">Principles</span></p></aside><div class="panel"><h2><span class="light-copy">전략, 디자인, 기술을 하나의 질문으로 묶습니다.</span><span class="dark-copy">One operating stack from signal to launch.</span></h2><p><span class="light-copy">좋은 해답은 여러 부서의 산출물을 이어 붙이는 방식으로 만들어지지 않습니다. 시장과 사용자의 신호를 읽고, 화면의 우선순위를 세우고, 운영 가능한 기술 구조로 연결할 때 결과가 선명해집니다.</span><span class="dark-copy">We connect strategy, interface, and engineering into one execution loop so teams can move from ambiguity to release without losing the core question.</span></p><div class="pill-list"><span class="pill">Strategy</span><span class="pill">Interface</span><span class="pill">Engineering</span><span class="pill">Iteration</span></div></div></div></section>
  <section class="content"><div class="shell section-grid"><aside><p class="eyebrow"><span class="light-copy">태도</span><span class="dark-copy">Method</span></p></aside><div class="panel"><h2><span class="light-copy">전통의 상징은 장식이 아니라 문제 해결의 태도입니다.</span><span class="dark-copy">Clarity is engineered, not decorated.</span></h2><p><span class="light-copy">라이트 모드의 한지, 오래된 홍색, 깊은 청색, 붓글씨는 단순한 분위기가 아닙니다. 어려움을 풀고 바른 방향으로 나아가려는 마음을 오늘의 디지털 경험으로 번역하는 장치입니다.</span><span class="dark-copy">In dark mode, the same intent turns into industrial rhythm: grids, neon signals, precise labels, and systems that reveal how decisions move.</span></p><a class="button" href="/project/"><span class="light-copy">과제 보기</span><span class="dark-copy">View Project</span></a></div></div></section>
</ContentLayout>