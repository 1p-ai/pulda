<body>
  <header>
    <nav class="shell" aria-label="주요 메뉴">
      <a class="logo" href="/" aria-label="풀다 홈"><span class="logo-mark" aria-hidden="true"></span><span class="dark-logo" aria-hidden="true">PULDA</span></a>
      <button class="menu" aria-label="메뉴 열기" aria-expanded="false"><span></span><span></span></button>
      <div class="links">
        <a href="/about/"><span class="light-copy">소개</span><span class="dark-copy">About</span></a>
        <a href="/project/"><span class="light-copy">과제</span><span class="dark-copy">Project</span></a>
        <a href="/story/"><span class="light-copy">이야기</span><span class="dark-copy">Story</span></a>
        <a href="/contact/"><span class="light-copy">만남</span><span class="dark-copy">Contact</span></a>
        <div class="theme-switch" role="group" aria-label="화면 테마">
          <button type="button" data-theme-choice="light" title="라이트 모드" aria-label="라이트 모드">日</button>
          <button type="button" data-theme-choice="dark" title="다크 모드" aria-label="다크 모드">月</button>
        </div>
      </div>
    </nav>
  </header>
  <main><slot /></main>
  <footer><div class="shell footer-row"><span><span class="light-copy">© 2026 풀다. 모든 권리를 보유합니다.</span><span class="dark-copy">© 2026 PULDA. All systems reserved.</span></span><span><a href="mailto:hello@pulda.com">hello@pulda.com</a></span></div></footer>
  <script is:inline>
    let fanAudioContext;
    function playFanSound(opening) {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const ctx = fanAudioContext || (fanAudioContext = new AudioContext());
        const now = ctx.currentTime;
        if (ctx.state === 'suspended') ctx.resume();
        const dark = document.documentElement.dataset.theme === 'dark';
        const master = ctx.createGain();
        master.gain.setValueAtTime(0.0001, now);
        master.gain.exponentialRampToValueAtTime(dark ? 0.18 : 0.105, now + 0.018);
        master.gain.exponentialRampToValueAtTime(0.0001, now + (dark ? 0.3 : 0.24));
        master.connect(ctx.destination);
        if (dark) {
          const zing = ctx.createOscillator();
          const zingGain = ctx.createGain();
          const ring = ctx.createOscillator();
          const ringGain = ctx.createGain();
          const sweep = opening ? 940 : 520;
          zing.type = 'sawtooth';
          zing.frequency.setValueAtTime(opening ? 320 : sweep, now);
          zing.frequency.exponentialRampToValueAtTime(opening ? 1850 : 180, now + 0.16);
          zingGain.gain.setValueAtTime(0.0001, now);
          zingGain.gain.exponentialRampToValueAtTime(0.13, now + 0.012);
          zingGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.18);
          ring.type = 'triangle';
          ring.frequency.setValueAtTime(opening ? 2400 : 1750, now + 0.015);
          ring.frequency.exponentialRampToValueAtTime(opening ? 1350 : 900, now + 0.11);
          ringGain.gain.setValueAtTime(0.0001, now + 0.01);
          ringGain.gain.exponentialRampToValueAtTime(0.09, now + 0.024);
          ringGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.13);
          zing.connect(zingGain);
          zingGain.connect(master);
          ring.connect(ringGain);
          ringGain.connect(master);
          zing.start(now);
          zing.stop(now + 0.19);
          ring.start(now + 0.01);
          ring.stop(now + 0.14);
          return;
        }
        const noise = ctx.createBufferSource();
        const buffer = ctx.createBuffer(1, ctx.sampleRate * 0.22, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < data.length; i += 1) {
          const fade = 1 - i / data.length;
          data[i] = (Math.random() * 2 - 1) * fade * 0.78;
        }
        noise.buffer = buffer;
        const filter = ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(opening ? 2250 : 1350, now);
        filter.Q.setValueAtTime(1.15, now);
        noise.connect(filter);
        filter.connect(master);
        noise.start(now);
        noise.stop(now + 0.22);
        const tap = ctx.createOscillator();
        const tapGain = ctx.createGain();
        tap.type = 'triangle';
        tap.frequency.setValueAtTime(opening ? 780 : 360, now);
        tap.frequency.exponentialRampToValueAtTime(opening ? 420 : 210, now + 0.08);
        tapGain.gain.setValueAtTime(0.0001, now);
        tapGain.gain.exponentialRampToValueAtTime(0.045, now + 0.01);
        tapGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.09);
        tap.connect(tapGain);
        tapGain.connect(master);
        tap.start(now);
        tap.stop(now + 0.13);
      } catch (error) {}
    }
    const menu = document.querySelector('.menu');
    menu?.addEventListener('click', () => {
      const opening = !document.body.classList.contains('menu-open');
      document.body.classList.remove('fan-opening', 'fan-closing');
      void menu.offsetWidth;
      document.body.classList.add(opening ? 'fan-opening' : 'fan-closing');
      window.setTimeout(() => document.body.classList.remove('fan-opening', 'fan-closing'), 460);
      playFanSound(opening);
      const open = document.body.classList.toggle('menu-open');
      menu.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
    });
    document.querySelectorAll('.links a').forEach((link) => link.addEventListener('click', () => document.body.classList.remove('menu-open')));
    const buttons = document.querySelectorAll('[data-theme-choice]');
    function setTheme(theme) {
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeChoice === theme)));
      try { localStorage.setItem('pulda-theme', theme); } catch (error) {}
    }
    let initialTheme = document.documentElement.dataset.theme || 'light';
    if (initialTheme !== 'dark' && initialTheme !== 'light') initialTheme = 'light';
    setTheme(initialTheme);
    buttons.forEach((button) => button.addEventListener('click', () => setTheme(button.dataset.themeChoice)));
  </script>
