---
import { getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getProjectPath } from '../../utils/contentRoutes';

const projects = (await getCollection('projects'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const dateFormatter = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: '2-digit' });
---
<ContentLayout title="과제" description="풀다가 질문을 정리하고 해답을 구현한 프로젝트 기록입니다." canonicalPath="/project/" eyebrow="Selected Projects">
  <section class="page-head"><div class="shell"><p class="eyebrow"><span class="light-copy">주요 과제</span><span class="dark-copy">Selected Systems</span></p><h1><span class="light-copy">명확해진 결과</span><span class="dark-copy">Deployed Outcomes</span></h1><p><span class="light-copy">문제의 맥락부터 실행과 결과까지, 함께 풀어낸 과정과 배움을 기록합니다.</span><span class="dark-copy">A record of systems shipped from business ambiguity to operational clarity.</span></p></div></section>
  <section class="content"><div class="shell content-list project-list">
    {projects.map((project) => <a class="content-item project-item" href={getProjectPath(project.id)}><time datetime={project.data.publishedAt.toISOString()}>{dateFormatter.format(project.data.publishedAt)}</time><div><p class="meta">{project.data.client} · {project.data.services.join(' / ')}</p><h2>{project.data.title}</h2><p>{project.data.description}</p>{project.data.outcome && <p class="outcome">{project.data.outcome}</p>}<div class="pill-list">{project.data.tags.slice(0, 4).map((tag) => <span class="pill">{tag}</span>)}</div></div><span class="meta">{project.data.services[0] ?? 'Case Study'}</span><span class="arrow" aria-hidden="true">↗</span></a>)}
  </div></section>
</ContentLayout>