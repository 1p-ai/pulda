---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  type?: 'website' | 'article' | 'project';
  publishedAt?: Date;
  updatedAt?: Date;
  image?: string;
  tags?: string[];
  noindex?: boolean;
  eyebrow?: string;
}

const {
  title,
  description,
  canonicalPath,
  type = 'website',
  publishedAt,
  updatedAt,
  image,
  tags = [],
  noindex = false,
  eyebrow = '풀다',
} = Astro.props;
const baseUrl = Astro.site ?? new URL(import.meta.env.PUBLIC_SITE_URL || 'https://www.puldaunion.com');
const canonicalUrl = new URL(canonicalPath, baseUrl);
const imageUrl = image ? new URL(image, baseUrl) : undefined;
const pageTitle = `${title} | 풀다`;
const schema = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: publishedAt?.toISOString(),
      dateModified: (updatedAt ?? publishedAt)?.toISOString(),
      author: { '@type': 'Organization', name: '풀다' },
      publisher: { '@type': 'Organization', name: '풀다' },
      mainEntityOfPage: canonicalUrl.toString(),
      image: imageUrl?.toString(),
      keywords: tags.join(', '),
    }
  : type === 'project'
    ? {
        '@context': 'https://schema.org',
        '@type': 'CreativeWork',
        name: title,
        description,
        datePublished: publishedAt?.toISOString(),
        url: canonicalUrl.toString(),
        image: imageUrl?.toString(),
        creator: { '@type': 'Organization', name: '풀다' },
        keywords: tags.join(', '),
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: title,
        description,
        url: canonicalUrl.toString(),
      };
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <script is:inline>
    try {
      const stored = localStorage.getItem('pulda-theme');
      const theme = stored === 'dark' || stored === 'light'
        ? stored
        : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
    } catch (error) {}
  </script>
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'}>
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:locale" content="ko_KR">
  <meta property="og:site_name" content="풀다">
  <meta property="og:type" content={type === 'article' ? 'article' : 'website'}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  {imageUrl && <meta property="og:image" content={imageUrl}>}
  <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'}>
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={description}>
  {imageUrl && <meta name="twitter:image" content={imageUrl}>}
  <meta name="theme-color" content="#f4ead8" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#050914" media="(prefers-color-scheme: dark)">
  {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()}>}
  {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()}>}
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700;800&family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@700&display=swap" rel="stylesheet">
  <style is:global>
    :root{--max:1180px}
    .shell{width:min(100%,var(--max));margin:auto;padding-inline:var(--pad)}
    main{min-height:70vh}
    .page-head{position:relative;isolation:isolate;padding:clamp(112px,12vw,172px) 0 80px;border-bottom:2px solid var(--line);overflow-x:clip}.page-head:after{content:"";position:absolute;z-index:-1;right:0;bottom:0;width:clamp(180px,16vw,280px);aspect-ratio:1.7/1;background:rgba(var(--red-rgb),.07);-webkit-mask:url("/logo/pulda-logo-red.webp") center/contain no-repeat;mask:url("/logo/pulda-logo-red.webp") center/contain no-repeat;pointer-events:none}.page-head h1{position:relative;max-width:900px;margin:0 0 24px;font-family:"Noto Sans KR","Hanken Grotesk",sans-serif;font-size:clamp(32px,4.8vw,76px);font-weight:700;line-height:1.18;letter-spacing:-.02em;word-break:keep-all;overflow-wrap:break-word}.page-head p{position:relative;max-width:720px;margin:0;font-size:clamp(15px,1.6vw,18px);word-break:keep-all;overflow-wrap:break-word}
    .content{padding:72px 0 128px}.section-grid{display:grid;grid-template-columns:minmax(180px,.8fr) minmax(0,1.6fr);gap:clamp(28px,5vw,76px);align-items:start}.panel{border-top:1px solid var(--line);padding-top:26px}.panel h2{margin:0 0 16px;font-size:clamp(28px,3.2vw,44px);line-height:1.18;word-break:keep-all}.panel p{margin:0 0 18px;font-size:18px;word-break:keep-all}.pill-list{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.pill{border:1px solid rgba(var(--red-rgb),.45);padding:7px 10px;color:var(--red);font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
    .content-list{border-top:1px solid var(--line)}.content-item{display:grid;grid-template-columns:140px 1fr auto;gap:28px;padding:34px 0;border-bottom:1px solid var(--line);align-items:start;transition:.22s}.content-item:hover{padding-inline:14px;background:rgba(var(--paper-rgb),.38)}.content-item time,.meta{font-size:12px;color:rgba(var(--navy-rgb),.66)}.content-item h2{margin:0 0 8px;font-size:clamp(20px,2vw,28px);word-break:keep-all}.content-item p{margin:0;font-size:14px;word-break:keep-all}
    /* 2026-07-10: project index now shows one evidence image per case while keeping the list scan-friendly. */
    .project-list .content-item{grid-template-columns:120px minmax(180px,240px) minmax(0,1fr) auto 24px}.project-thumb{margin:0;overflow:hidden;border:1px solid var(--line);background:rgba(var(--paper-rgb),.64);aspect-ratio:4/3}.project-thumb img{display:block;width:100%;height:100%;object-fit:cover;object-position:top}.project-thumb-placeholder{position:relative;overflow:hidden;background:linear-gradient(145deg,var(--hanji) 0%,var(--paper-deep) 100%)}.project-thumb-placeholder:before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(-45deg,transparent 0,transparent 12px,rgba(var(--navy-rgb),.042) 12px,rgba(var(--navy-rgb),.042) 13px)}.project-thumb-placeholder:after{content:"P";position:absolute;right:10px;bottom:6px;font-family:"Hanken Grotesk",sans-serif;font-size:54px;font-weight:900;line-height:1;letter-spacing:-.04em;color:rgba(var(--red-rgb),.13)}.project-item .outcome{margin-top:10px;font-size:12px;color:rgba(var(--navy-rgb),.72)}.project-item .tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}.project-item .tag-pill{padding:3px 8px;border:1px solid rgba(var(--red-rgb),.3);color:var(--red);font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.story-feature{display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--line)}.story-feature-copy{display:flex;flex-direction:column;justify-content:flex-end;padding:48px;min-height:460px}.story-feature img{width:100%;height:100%;object-fit:contain;background:rgba(var(--paper-rgb),.68);min-height:380px;display:block}.story-card-list{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-bottom:1px solid var(--line)}.story-card{display:grid;grid-template-columns:160px minmax(0,1fr);border-right:1px solid var(--line)}.story-card:last-child{border-right:0}.story-card img{width:100%;height:100%;object-fit:contain;background:rgba(var(--paper-rgb),.68);min-height:260px;display:block}.story-card-copy{padding:32px 28px;display:flex;flex-direction:column;justify-content:space-between}.story-card p{margin:10px 0 0;font-size:14px;color:rgba(var(--navy-rgb),.72)}.related-story-list{display:grid;grid-template-columns:repeat(2,1fr);gap:0}.related-story-list .content-item{grid-template-columns:1fr}.story-principle-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(24px,3vw,48px);margin-top:32px}.prose p{margin:0 0 22px;font-size:17px;line-height:1.8;word-break:keep-all}.prose h2{margin:48px 0 20px;font-size:clamp(22px,2.4vw,32px)}.prose h3{margin:32px 0 14px;font-size:clamp(18px,1.8vw,24px)}.prose ul,.prose ol{margin:0 0 22px;padding-left:22px}.prose li{margin-bottom:8px;font-size:17px;line-height:1.8}.prose blockquote{margin:32px 0;padding:20px 28px;border-left:3px solid var(--red);background:rgba(var(--red-rgb),.06)}.prose blockquote p{margin:0;font-style:italic}.prose a{color:var(--red);text-decoration:underline;text-underline-offset:3px}.hero-shot{margin:0 0 32px;overflow:hidden}.hero-shot img{width:100%;max-width:100%;height:auto;max-height:560px;object-fit:contain;background:rgba(var(--paper-rgb),.68);display:block}.case-visual-lead{margin-bottom:32px}.case-origin-figure{margin:40px 0;overflow:hidden}.case-origin-figure img{width:100%;max-width:100%;height:auto;display:block}.case-meta-panel{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:48px 0;background:var(--line)}.case-meta-panel div{padding:24px 28px;background:var(--paper)}.case-meta-panel h3,.case-meta-panel div>span{display:block;margin:0 0 8px;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(var(--navy-rgb),.58)}.case-meta-panel p,.case-meta-panel div>strong{display:block;margin:0;font-size:14px;font-weight:600;font-style:normal}.case-summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);margin:32px 0}.case-summary-grid>div{padding:18px 22px;background:var(--paper)}.case-summary-grid>div>span{display:block;margin-bottom:6px;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(var(--navy-rgb),.54)}.case-summary-grid>div>strong{display:block;font-size:14px;font-weight:600;font-style:normal}.case-map{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);margin:32px 0}.case-map>div{padding:22px 24px;background:var(--paper)}.case-map>div>span{display:block;font-size:11px;font-weight:800;letter-spacing:.1em;color:rgba(var(--navy-rgb),.38);margin-bottom:6px}.case-map>div>strong{display:block;font-size:16px;font-weight:700;margin-bottom:6px;font-style:normal}.case-map>div>p{margin:0;font-size:14px;color:rgba(var(--navy-rgb),.68)}.related-story-list a{display:block;padding:28px 24px;border-bottom:1px solid var(--line);text-decoration:none;color:inherit;transition:.2s}.related-story-list a:hover{background:rgba(var(--paper-rgb),.5)}.related-story-list a>span{display:block;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:8px}.related-story-list a>strong{display:block;font-size:clamp(18px,1.8vw,24px);font-weight:600;margin-bottom:6px;color:inherit}.related-story-list a>p{margin:0;font-size:14px;color:rgba(var(--navy-rgb),.66)}.back{display:inline-flex;align-items:center;gap:8px;margin-bottom:48px;padding:10px 18px;border:1px solid var(--line);font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;transition:.2s}.back:hover{border-color:var(--red);color:var(--red)}
    /* 2026-07-07: case images now favor full-screen evidence over cropped thumbnails for project/story review. */
    .case-gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin:32px 0 72px}.gallery-item{margin:0;border:1px solid var(--line);background:rgba(var(--paper-rgb),.54);overflow:hidden}.gallery-item.large{grid-column:1/-1}.gallery-item img{display:block;width:100%;height:clamp(240px,34vw,460px);object-fit:contain;object-position:top;background:rgba(var(--paper-rgb),.64)}.gallery-item figcaption{display:block;padding:16px 18px;border-top:1px solid var(--line);font-size:13px;line-height:1.55;color:rgba(var(--navy-rgb),.72)}.gallery-item figcaption strong{display:block;margin-bottom:4px;color:var(--navy);font-size:12px;text-transform:uppercase;letter-spacing:.08em}.gallery-item figcaption span{display:block}
