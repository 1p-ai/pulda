---
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  type?: 'website' | 'article' | 'project';
  publishedAt?: Date;
  updatedAt?: Date;
  image?: string;
  tags?: string[];
  noindex?: boolean;
  eyebrow?: string;
}

const {
  title,
  description,
  canonicalPath,
  type = 'website',
  publishedAt,
  updatedAt,
  image,
  tags = [],
  noindex = false,
  eyebrow = 'Pulda',
} = Astro.props;
const baseUrl = Astro.site ?? new URL(import.meta.env.PUBLIC_SITE_URL || 'https://example.com');
const canonicalUrl = new URL(canonicalPath, baseUrl);
const imageUrl = image ? new URL(image, baseUrl) : undefined;
const pageTitle = `${title} | 풀다`;
const schema = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: publishedAt?.toISOString(),
      dateModified: (updatedAt ?? publishedAt)?.toISOString(),
      author: { '@type': 'Organization', name: '풀다' },
      publisher: { '@type': 'Organization', name: '풀다' },
      mainEntityOfPage: canonicalUrl.toString(),
      image: imageUrl?.toString(),
      keywords: tags.join(', '),
    }
  : type === 'project'
    ? {
        '@context': 'https://schema.org',
        '@type': 'CreativeWork',
        name: title,
        description,
        datePublished: publishedAt?.toISOString(),
        url: canonicalUrl.toString(),
        image: imageUrl?.toString(),
        creator: { '@type': 'Organization', name: '풀다' },
        keywords: tags.join(', '),
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: title,
        description,
        url: canonicalUrl.toString(),
      };
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <script is:inline>
    try {
      const stored = localStorage.getItem('pulda-theme');
      const theme = stored === 'dark' || stored === 'light'
        ? stored
        : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
    } catch (error) {}
  </script>
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'}>
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:locale" content="ko_KR">
  <meta property="og:site_name" content="풀다">
  <meta property="og:type" content={type === 'article' ? 'article' : 'website'}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  {imageUrl && <meta property="og:image" content={imageUrl}>}
  <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'}>
  <meta name="theme-color" content="#f4ead8" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#050914" media="(prefers-color-scheme: dark)">
  {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()}>}
  {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()}>}
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700;800&family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@700&display=swap" rel="stylesheet">
