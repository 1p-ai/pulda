<style>
@font-face{font-family:"Solmoe Kim Daegeon";src:url("/fonts/SolmoeKimDaegeon-Medium.woff") format("woff");font-weight:500;font-style:normal;font-display:swap}
:root{--hanji:#f4ead8;--hanji-rgb:244,234,216;--paper:#fbf4e7;--paper-rgb:251,244,231;--paper-deep:#e6d5b9;--ivory:var(--hanji);--navy:#13233a;--navy-rgb:19,35,58;--navy2:#1d304b;--red:#9f3a32;--red-rgb:159,58,50;--red-on-dark:#cf6b5a;--red-on-dark-rgb:207,107,90;--white:#fbf4e7;--line:rgba(var(--navy-rgb),.18);--tech-bg:#050914;--tech-panel:#0a1222;--tech-panel2:#101b30;--tech-red:#ff2d2d;--tech-red-rgb:255,45,45;--tech-orange:#ff9b3d;--tech-cyan:#7ddcff;--tech-white:#edf4ff;--pad:clamp(20px,5vw,72px);--max:1440px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background-color:var(--ivory);background-image:linear-gradient(rgba(var(--paper-rgb),.48),rgba(var(--hanji-rgb),.36)),url("/logo/hanji-background-full.webp");background-size:auto,cover;background-position:center top;background-repeat:no-repeat;background-attachment:fixed;color:var(--navy);font-family:"Hanken Grotesk","Noto Sans KR",sans-serif;line-height:1.6;overflow-x:hidden}body.menu-open{overflow:hidden}a{color:inherit;text-decoration:none}button{font:inherit;color:inherit}h1,h2,h3,p{margin-top:0}.shell{width:min(100%,var(--max));margin:auto;padding-inline:var(--pad)}
