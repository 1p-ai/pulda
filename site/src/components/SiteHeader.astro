<style is:global>
@font-face{font-family:"Solmoe Kim Daegeon";src:url("/fonts/SolmoeKimDaegeon-Medium.woff") format("woff");font-weight:500;font-style:normal;font-display:swap}
:root{--hanji:#f4ead8;--hanji-rgb:244,234,216;--paper:#fbf4e7;--paper-rgb:251,244,231;--paper-deep:#e6d5b9;--ivory:var(--hanji);--navy:#13233a;--navy-rgb:19,35,58;--navy2:#1d304b;--red:#9f3a32;--red-rgb:159,58,50;--red-on-dark:#cf6b5a;--red-on-dark-rgb:207,107,90;--white:#fbf4e7;--line:rgba(var(--navy-rgb),.18);--tech-bg:#050914;--tech-panel:#0a1222;--tech-panel2:#101b30;--tech-red:#ff2d2d;--tech-red-rgb:255,45,45;--tech-orange:#ff9b3d;--tech-cyan:#7ddcff;--tech-white:#edf4ff;--pad:clamp(40px,6vw,96px)}
*{box-sizing:border-box}html{scroll-behavior:smooth}.shell{width:min(100%,var(--max,1440px));margin:auto;padding-inline:var(--pad)}body{margin:0;background-color:var(--ivory);background-image:linear-gradient(rgba(var(--paper-rgb),.48),rgba(var(--hanji-rgb),.36)),url("/logo/hanji-background-full.webp");background-size:auto,cover;background-position:center top;background-repeat:no-repeat;background-attachment:fixed;color:var(--navy);font-family:"Hanken Grotesk","Noto Sans KR",sans-serif;line-height:1.6;overflow-x:hidden}body.menu-open{overflow:hidden}a{color:inherit;text-decoration:none}button{font:inherit;color:inherit}h1,h2,h3,p{margin-top:0}
.eyebrow{display:flex;align-items:center;gap:12px;margin:0 0 24px;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.eyebrow:before{content:"";width:7px;height:7px;background:var(--red);flex:none}
.light-copy{display:inline}.dark-copy{display:none}
header{position:fixed;z-index:20;inset:0 0 auto;height:88px;border-bottom:1px solid var(--line);background:rgba(var(--paper-rgb),.82);backdrop-filter:blur(18px)}nav{height:100%;display:flex;align-items:center;justify-content:space-between}.logo{display:inline-flex;align-items:center;width:72px;height:42px}.logo-mark{display:block;width:100%;height:100%;background:var(--red);-webkit-mask:url("/logo/pulda-logo-red.webp") center/contain no-repeat;mask:url("/logo/pulda-logo-red.webp") center/contain no-repeat}.dark-logo{display:none}
.nav-links{display:flex;align-items:center;gap:36px;font-size:14px;font-weight:600}.nav-links>a:not(.cta){position:relative;padding:6px 0;isolation:isolate}.nav-links>a:not(.cta):before{content:"";position:absolute;z-index:-1;left:-12px;right:-12px;top:50%;height:30px;background:radial-gradient(ellipse at 22% 55%,rgba(var(--red-rgb),.16),transparent 62%),radial-gradient(ellipse at 72% 48%,rgba(var(--red-rgb),.11),transparent 68%);opacity:0;transform:translateY(-48%) scale(.86,.72);filter:blur(7px);transition:opacity .28s ease,transform .28s ease}.nav-links>a:not(.cta):after{content:"";position:absolute;left:-5px;right:-5px;bottom:-7px;height:9px;background:linear-gradient(90deg,rgba(var(--red-rgb),.08) 0%,var(--red) 14%,var(--red) 72%,rgba(var(--red-rgb),.38) 88%,rgba(var(--red-rgb),0) 100%);border-radius:999px 68% 74% 999px;opacity:0;transform:scaleX(.18) translateY(1px) rotate(-2.2deg);transform-origin:left center;transition:transform .32s cubic-bezier(.16,.82,.22,1),opacity .18s ease;box-shadow:0 2px 0 rgba(var(--red-rgb),.18),0 5px 12px rgba(var(--red-rgb),.12);clip-path:polygon(0 38%,7% 24%,23% 18%,48% 24%,74% 18%,92% 28%,100% 43%,97% 66%,70% 78%,38% 72%,13% 82%,0 66%)}.nav-links>a:not(.cta):hover:before{opacity:1;transform:translateY(-48%) scale(1,.92)}.nav-links>a:not(.cta):hover:after{opacity:.95;transform:scaleX(1) translateY(1px) rotate(-2.2deg)}.nav-links>a:not(.cta) .light-copy{font-family:"Solmoe Kim Daegeon","Noto Serif KR",serif;font-size:19px;font-weight:500}
.theme-switch{display:grid;grid-template-columns:30px 30px;height:32px;border:1px solid var(--line)}.theme-switch button{width:30px;height:30px;padding:0;border:0;border-left:1px solid var(--line);background:transparent;color:var(--navy);font-family:"Solmoe Kim Daegeon",serif;font-size:17px;line-height:30px;cursor:pointer}.theme-switch button:first-child{border-left:0}.theme-switch button[aria-pressed="true"]{background:var(--red);color:var(--white)}.theme-switch button:focus-visible{outline-offset:2px}
.button,.cta{min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:14px;padding:0 22px;border:2px solid var(--navy);background:var(--navy);color:var(--white);font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;transition:.2s}.button:hover,.cta:hover{border-color:var(--red);background:var(--red);color:var(--white)}.button.outline{background:transparent;color:var(--navy)}.button.outline:hover{border-color:var(--red);background:var(--red);color:var(--white)}.arrow{font-size:18px}
.services .button.outline{border-color:rgba(var(--paper-rgb),.72);color:var(--white)}.services .button.outline:hover{border-color:var(--white);background:var(--white);color:var(--navy)}
.menu{position:relative;display:none;width:58px;height:48px;padding:0;border:0;background:none;cursor:pointer}.menu:before{content:"";position:absolute;inset:0;background:url("/logo/fan-menu-closed.png") center/48px auto no-repeat;transition:transform .22s ease,opacity .22s ease}.menu span{display:none}html:not([data-theme="dark"]) .menu:before{transform:rotate(-22deg) scale(.94);transform-origin:50% 58%;transition:transform .34s cubic-bezier(.2,.8,.2,1),filter .22s ease}html:not([data-theme="dark"]) .menu-open .menu:before{background-image:url("/logo/fan-menu-open.png");background-size:52px auto;transform:translateY(1px) rotate(23deg) scale(1)}html:not([data-theme="dark"]) body.fan-opening .menu:before{animation:fanOpenSpin .42s cubic-bezier(.2,.84,.18,1)}html:not([data-theme="dark"]) body.fan-closing .menu:before{animation:fanCloseSpin .38s cubic-bezier(.32,0,.2,1)}.menu-open .menu:before{background-image:url("/logo/fan-menu-open.png");background-size:52px auto;transform:translateY(1px)}@keyframes fanOpenSpin{0%{transform:rotate(-22deg) scale(.94)}58%{transform:rotate(31deg) scale(1.04)}100%{transform:translateY(1px) rotate(23deg) scale(1)}}@keyframes fanCloseSpin{0%{transform:translateY(1px) rotate(23deg) scale(1)}48%{transform:rotate(-34deg) scale(1.02)}100%{transform:rotate(-22deg) scale(.94)}}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s,transform .7s}.reveal.visible{opacity:1;transform:none}
:focus-visible{outline:3px solid var(--red);outline-offset:4px}
html[data-theme="dark"]{--line:rgba(237,244,255,.16);--red:var(--tech-red);--red-rgb:var(--tech-red-rgb);color-scheme:dark}html[data-theme="dark"] body{background:var(--tech-bg);background-image:radial-gradient(circle at 76% 16%,rgba(var(--tech-red-rgb),.20),transparent 28%),radial-gradient(circle at 20% 80%,rgba(125,220,255,.12),transparent 28%),linear-gradient(135deg,#050914,#08111f 48%,#06070d);color:var(--tech-white)}html[data-theme="dark"] body:before{content:"";position:fixed;inset:0;z-index:-1;background:linear-gradient(rgba(237,244,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(237,244,255,.035) 1px,transparent 1px);background-size:42px 42px;pointer-events:none}html[data-theme="dark"] .light-copy{display:none}html[data-theme="dark"] .dark-copy{display:inline}html[data-theme="dark"] header{background:rgba(5,9,20,.78);border-color:rgba(237,244,255,.14)}html[data-theme="dark"] .logo{width:auto;min-width:116px;height:50px}html[data-theme="dark"] .logo-mark{display:none}html[data-theme="dark"] .dark-logo{display:inline-flex;align-items:center;color:var(--tech-white);font-size:22px;font-weight:800;letter-spacing:.22em;text-shadow:0 0 16px rgba(var(--tech-red-rgb),.45)}html[data-theme="dark"] .dark-logo:before{content:"";width:9px;height:9px;margin-right:12px;background:var(--tech-red);box-shadow:0 0 18px rgba(var(--tech-red-rgb),.85),0 0 38px rgba(var(--tech-red-rgb),.45)}html[data-theme="dark"] .nav-links>a:not(.cta){font-size:12px;font-weight:800;letter-spacing:.15em;text-transform:uppercase;color:rgba(237,244,255,.78)}html[data-theme="dark"] .nav-links>a:not(.cta) .light-copy{font-family:inherit;font-size:inherit;font-weight:inherit}html[data-theme="dark"] .nav-links>a:not(.cta):after{background:linear-gradient(90deg,var(--tech-red),var(--tech-orange));box-shadow:0 0 14px rgba(var(--tech-red-rgb),.7)}html[data-theme="dark"] .theme-switch{position:relative;grid-template-columns:1fr;width:58px;height:30px;border:1px solid rgba(237,244,255,.24);border-radius:999px;background:rgba(237,244,255,.08);box-shadow:inset 0 0 14px rgba(0,0,0,.32),0 0 18px rgba(var(--tech-red-rgb),.14)}html[data-theme="dark"] .theme-switch button{position:absolute;top:0;bottom:0;width:50%;height:100%;border:0!important;background:transparent!important;color:transparent!important;font-size:0!important;line-height:0;cursor:pointer}html[data-theme="dark"] .theme-switch button[data-theme-choice="light"]{left:0}html[data-theme="dark"] .theme-switch button[data-theme-choice="dark"]{right:0}html[data-theme="dark"] .theme-switch button:before{content:"";position:absolute;top:4px;left:4px;width:20px;height:20px;border-radius:50%;background:rgba(237,244,255,.52);box-shadow:0 0 10px rgba(237,244,255,.28)}html[data-theme="dark"] .theme-switch button[data-theme-choice="dark"]:before{background:var(--tech-red);box-shadow:0 0 14px rgba(var(--tech-red-rgb),.86),0 0 30px rgba(var(--tech-red-rgb),.44)}html[data-theme="dark"] .theme-switch button[aria-pressed="false"]:before{opacity:0}html[data-theme="dark"] .theme-switch button[aria-pressed="true"]:before{opacity:1}html[data-theme="dark"] .button,html[data-theme="dark"] .cta{border-color:var(--tech-red);background:linear-gradient(135deg,var(--tech-red),#a90f14);color:#fff;box-shadow:0 0 22px rgba(var(--tech-red-rgb),.32)}html[data-theme="dark"] .button.outline{background:transparent;border-color:rgba(237,244,255,.34);color:var(--tech-white)}html[data-theme="dark"] .button.outline:hover{border-color:var(--tech-red);background:var(--tech-red);color:#fff}html[data-theme="dark"] .menu:before{background:none}html[data-theme="dark"] .menu span{display:block;position:absolute;left:13px;right:13px;height:2px;background:var(--tech-white);box-shadow:0 0 12px rgba(var(--tech-red-rgb),.42);transition:.22s}html[data-theme="dark"] .menu span:first-child{top:17px}html[data-theme="dark"] .menu span:last-child{top:29px}html[data-theme="dark"] .menu-open .menu span:first-child{top:23px;transform:rotate(45deg)}html[data-theme="dark"] .menu-open .menu span:last-child{top:23px;transform:rotate(-45deg)}
html[data-theme="dark"] .button,html[data-theme="dark"] .cta{border-color:var(--tech-red);background:var(--tech-red);color:var(--tech-white)}html[data-theme="dark"] .button:hover,html[data-theme="dark"] .cta:hover{border-color:var(--tech-cyan);background:var(--tech-cyan);color:var(--tech-bg)}html[data-theme="dark"] .button.outline{border-color:rgba(237,244,255,.52);background:transparent;color:var(--tech-white)}html[data-theme="dark"] .button.outline:hover{border-color:var(--tech-red);background:var(--tech-red);color:var(--tech-white)}html[data-theme="dark"] .services .button.outline{border-color:rgba(237,244,255,.52);color:var(--tech-white)}html[data-theme="dark"] .services .button.outline:hover{border-color:var(--tech-cyan);background:var(--tech-cyan);color:var(--tech-bg)}
@media(max-width:820px){header{height:72px}.menu{display:block}.nav-links{position:fixed;inset:72px 0 auto;display:none;align-items:stretch;gap:0;padding:24px var(--pad,clamp(20px,5vw,72px)) 32px;border-bottom:1px solid var(--line);background:var(--ivory)}.menu-open .nav-links{display:flex;flex-direction:column}.nav-links a{padding:16px 0;font-size:18px}.nav-links .theme-switch{margin:12px 0}.nav-links .cta{margin-top:12px}html[data-theme="dark"] .nav-links{background:var(--tech-bg)}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important;animation:none!important}}
</style>

<header>
  <nav class="shell" aria-label="주요 메뉴">
    <a class="logo" href="/" aria-label="풀다 홈">
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="dark-logo" aria-hidden="true">PULDA</span>
    </a>
    <button class="menu" aria-label="메뉴 열기" aria-expanded="false">
      <span></span><span></span>
    </button>
    <div class="nav-links">
      <a href="/about/"><span class="light-copy">소개</span><span class="dark-copy">About</span></a>
      <a href="/project/"><span class="light-copy">과제</span><span class="dark-copy">Project</span></a>
      <a href="/story/"><span class="light-copy">이야기</span><span class="dark-copy">Story</span></a>
      <a href="/contact/"><span class="light-copy">만남</span><span class="dark-copy">Contact</span></a>
      <div class="theme-switch" role="group" aria-label="화면 테마">
        <button type="button" data-theme-choice="light" title="라이트 모드" aria-label="라이트 모드">양</button>
        <button type="button" data-theme-choice="dark" title="다크 모드" aria-label="다크 모드">음</button>
      </div>
      <a class="cta" href="/contact/">
        <span class="light-copy">함께 풀기</span><span class="dark-copy">Start Project</span>
        <span class="arrow">↗</span>
      </a>
    </div>
  </nav>
</header>

<script is:inline>
let fanAudioContext;function playFanSound(opening){if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;try{const AudioContext=window.AudioContext||window.webkitAudioContext;if(!AudioContext)return;const ctx=fanAudioContext||(fanAudioContext=new AudioContext());const now=ctx.currentTime;if(ctx.state==='suspended')ctx.resume();const master=ctx.createGain();const dark=document.documentElement.dataset.theme==='dark';master.gain.setValueAtTime(.0001,now);master.gain.exponentialRampToValueAtTime(dark?.18:.105,now+.018);master.gain.exponentialRampToValueAtTime(.0001,now+(dark?.3:.24));master.connect(ctx.destination);if(dark){const zing=ctx.createOscillator();const zingGain=ctx.createGain();const ring=ctx.createOscillator();const ringGain=ctx.createGain();const sweep=opening?940:520;zing.type='sawtooth';zing.frequency.setValueAtTime(opening?320:sweep,now);zing.frequency.exponentialRampToValueAtTime(opening?1850:180,now+.16);zingGain.gain.setValueAtTime(.0001,now);zingGain.gain.exponentialRampToValueAtTime(.13,now+.012);zingGain.gain.exponentialRampToValueAtTime(.0001,now+.18);ring.type='triangle';ring.frequency.setValueAtTime(opening?2400:1750,now+.015);ring.frequency.exponentialRampToValueAtTime(opening?1350:900,now+.11);ringGain.gain.setValueAtTime(.0001,now+.01);ringGain.gain.exponentialRampToValueAtTime(.09,now+.024);ringGain.gain.exponentialRampToValueAtTime(.0001,now+.13);zing.connect(zingGain);zingGain.connect(master);ring.connect(ringGain);ringGain.connect(master);zing.start(now);zing.stop(now+.19);ring.start(now+.01);ring.stop(now+.14);return}const noise=ctx.createBufferSource();const buffer=ctx.createBuffer(1,ctx.sampleRate*.22,ctx.sampleRate);const data=buffer.getChannelData(0);for(let i=0;i<data.length;i++){const fade=1-i/data.length;data[i]=(Math.random()*2-1)*fade*.78}noise.buffer=buffer;const filter=ctx.createBiquadFilter();filter.type='bandpass';filter.frequency.setValueAtTime(opening?2250:1350,now);filter.Q.setValueAtTime(1.15,now);noise.connect(filter);filter.connect(master);noise.start(now);noise.stop(now+.22);const tap=ctx.createOscillator();const tapGain=ctx.createGain();tap.type='triangle';tap.frequency.setValueAtTime(opening?780:360,now);tap.frequency.exponentialRampToValueAtTime(opening?420:210,now+.08);tapGain.gain.setValueAtTime(.0001,now);tapGain.gain.exponentialRampToValueAtTime(.045,now+.01);tapGain.gain.exponentialRampToValueAtTime(.0001,now+.09);tap.connect(tapGain);tapGain.connect(master);tap.start(now);tap.stop(now+.13)}catch(error){}}
const menu=document.querySelector('.menu');
menu?.addEventListener('click',()=>{const opening=!document.body.classList.contains('menu-open');document.body.classList.remove('fan-opening','fan-closing');void menu.offsetWidth;document.body.classList.add(opening?'fan-opening':'fan-closing');window.setTimeout(()=>document.body.classList.remove('fan-opening','fan-closing'),460);playFanSound(opening);const open=document.body.classList.toggle('menu-open');menu.setAttribute('aria-expanded',String(open));menu.setAttribute('aria-label',open?'메뉴 닫기':'메뉴 열기')});
document.querySelectorAll('.nav-links a').forEach(a=>a.addEventListener('click',()=>document.body.classList.remove('menu-open')));
const themeButtons=document.querySelectorAll('[data-theme-choice]');
function setTheme(theme){document.documentElement.dataset.theme=theme;document.documentElement.style.colorScheme=theme;themeButtons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.themeChoice===theme)));try{localStorage.setItem('pulda-theme',theme)}catch(error){}}
let initialTheme=document.documentElement.dataset.theme||'light';
if(initialTheme!=='dark'&&initialTheme!=='light')initialTheme='light';
setTheme(initialTheme);
themeButtons.forEach(button=>button.addEventListener('click',()=>setTheme(button.dataset.themeChoice)));
</script>
