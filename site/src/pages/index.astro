let fanAudioContext;function playFanSound(opening){if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;try{const AudioContext=window.AudioContext||window.webkitAudioContext;if(!AudioContext)return;const ctx=fanAudioContext||(fanAudioContext=new AudioContext());const now=ctx.currentTime;if(ctx.state==='suspended')ctx.resume();const master=ctx.createGain();const dark=document.documentElement.dataset.theme==='dark';master.gain.setValueAtTime(.0001,now);master.gain.exponentialRampToValueAtTime(dark?.18:.105,now+.018);master.gain.exponentialRampToValueAtTime(.0001,now+(dark?.3:.24));master.connect(ctx.destination);if(dark){const zing=ctx.createOscillator();const zingGain=ctx.createGain();const ring=ctx.createOscillator();const ringGain=ctx.createGain();const sweep=opening?940:520;zing.type='sawtooth';zing.frequency.setValueAtTime(opening?320:sweep,now);zing.frequency.exponentialRampToValueAtTime(opening?1850:180,now+.16);zingGain.gain.setValueAtTime(.0001,now);zingGain.gain.exponentialRampToValueAtTime(.13,now+.012);zingGain.gain.exponentialRampToValueAtTime(.0001,now+.18);ring.type='triangle';ring.frequency.setValueAtTime(opening?2400:1750,now+.015);ring.frequency.exponentialRampToValueAtTime(opening?1350:900,now+.11);ringGain.gain.setValueAtTime(.0001,now+.01);ringGain.gain.exponentialRampToValueAtTime(.09,now+.024);ringGain.gain.exponentialRampToValueAtTime(.0001,now+.13);zing.connect(zingGain);zingGain.connect(master);ring.connect(ringGain);ringGain.connect(master);zing.start(now);zing.stop(now+.19);ring.start(now+.01);ring.stop(now+.14);return}const noise=ctx.createBufferSource();const buffer=ctx.createBuffer(1,ctx.sampleRate*.22,ctx.sampleRate);const data=buffer.getChannelData(0);for(let i=0;i<data.length;i++){const fade=1-i/data.length;data[i]=(Math.random()*2-1)*fade*.78}noise.buffer=buffer;const filter=ctx.createBiquadFilter();filter.type='bandpass';filter.frequency.setValueAtTime(opening?2250:1350,now);filter.Q.setValueAtTime(1.15,now);noise.connect(filter);filter.connect(master);noise.start(now);noise.stop(now+.22);const tap=ctx.createOscillator();const tapGain=ctx.createGain();tap.type='triangle';tap.frequency.setValueAtTime(opening?780:360,now);tap.frequency.exponentialRampToValueAtTime(opening?420:210,now+.08);tapGain.gain.setValueAtTime(.0001,now);tapGain.gain.exponentialRampToValueAtTime(.045,now+.01);tapGain.gain.exponentialRampToValueAtTime(.0001,now+.09);tap.connect(tapGain);tapGain.connect(master);tap.start(now);tap.stop(now+.13)}catch(error){}}const menu=document.querySelector('.menu');menu.addEventListener('click',()=>{const opening=!document.body.classList.contains('menu-open');document.body.classList.remove('fan-opening','fan-closing');void menu.offsetWidth;document.body.classList.add(opening?'fan-opening':'fan-closing');window.setTimeout(()=>document.body.classList.remove('fan-opening','fan-closing'),460);playFanSound(opening);const open=document.body.classList.toggle('menu-open');menu.setAttribute('aria-expanded',open);menu.setAttribute('aria-label',open?'메뉴 닫기':'메뉴 열기')});document.querySelectorAll('.nav-links a').forEach(a=>a.addEventListener('click',()=>document.body.classList.remove('menu-open')));const themeButtons=document.querySelectorAll('[data-theme-choice]');function setTheme(theme){document.documentElement.dataset.theme=theme;document.documentElement.style.colorScheme=theme;themeButtons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.themeChoice===theme)));try{localStorage.setItem('pulda-theme',theme)}catch(error){}}let initialTheme=document.documentElement.dataset.theme||'light';if(initialTheme!=='dark'&&initialTheme!=='light')initialTheme='light';setTheme(initialTheme);themeButtons.forEach(button=>button.addEventListener('click',()=>setTheme(button.dataset.themeChoice)));
const observer=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');observer.unobserve(e.target)}}),{threshold:.12});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
(()=>{const canvas=document.querySelector('#silk');const gl=canvas.getContext('webgl');if(!gl)return;const vs=`attribute vec2 p;varying vec2 v;void main(){v=p*.5+.5;gl_Position=vec4(p,0.,1.);}`;const fs=`precision highp float;uniform float time;uniform float darkMode;varying vec2 v;
vec3 mod289(vec3 x){return x-floor(x/289.)*289.;}vec2 mod289(vec2 x){return x-floor(x/289.)*289.;}vec3 permute(vec3 x){return mod289(((x*34.)+1.)*x);}float snoise(vec2 q){const vec4 C=vec4(.2113248654,.3660254038,-.5773502692,.0243902439);vec2 i=floor(q+dot(q,C.yy));vec2 x0=q-i+dot(i,C.xx);vec2 i1=x0.x>x0.y?vec2(1.,0.):vec2(0.,1.);vec4 x12=x0.xyxy+C.xxzz;x12.xy-=i1;i=mod289(i);vec3 p=permute(permute(i.y+vec3(0.,i1.y,1.))+i.x+vec3(0.,i1.x,1.));vec3 m=max(.5-vec3(dot(x0,x0),dot(x12.xy,x12.xy),dot(x12.zw,x12.zw)),0.);m=m*m;m=m*m;vec3 x=2.*fract(p*C.www)-1.;vec3 h=abs(x)-.5;vec3 ox=floor(x+.5);vec3 a=x-ox;m*=1.792842914-.853734721*(a*a+h*h);vec3 g;g.x=a.x*x0.x+h.x*x0.y;g.yz=a.yz*x12.xz+h.yz*x12.yw;return 130.*dot(m,g);}void main(){vec2 uv=v;vec2 flow=vec2(1.-uv.x,uv.y);float t=time*.2;float silk=0.,depth=0.;for(float i=1.;i<=6.;i++){float noise=snoise(vec2(flow.x*.3+t*.1,t*.15+i*2.5));float wave=sin(flow.x*(1.2+i*.35)-t*i*.25+noise*1.5)*.15;float y=.5+sin(t*.15+i)*.065;float dist=abs(flow.y-y-wave);float thick=.058/i+.006;silk+=smoothstep(thick,0.,dist)*(.74/i);depth+=smoothstep(thick*.36,0.,dist)*(.86/i);}float focus=smoothstep(.14,.92,uv.x);silk*=focus;depth*=focus;vec3 burgundy=vec3(.36,.11,.09);vec3 red=vec3(.61,.23,.19);vec3 neon=vec3(1.,.08,.06);vec3 hot=vec3(1.,.46,.18);vec3 cyan=vec3(.25,.82,1.);float body=clamp(silk*.76+depth*.30,0.,1.);vec3 lightColor=mix(burgundy,red,clamp(depth*.42,0.,1.));float pulse=.65+.35*sin(time*1.8+uv.x*7.);float core=pow(clamp(depth*1.45,0.,1.),1.35);float aura=pow(clamp(silk*1.15,0.,1.),1.8);vec3 darkColor=mix(neon,hot,core*.55)+cyan*aura*.18;float darkAlpha=clamp((body*.92+core*.48)*focus*(.86+.22*pulse),0.,.94);vec3 color=mix(lightColor,darkColor,darkMode);float alpha=mix(clamp(body*focus,0.,.72),darkAlpha,darkMode);gl_FragColor=vec4(color,alpha);}`;
function shader(type,src){const s=gl.createShader(type);gl.shaderSource(s,src);gl.compileShader(s);if(!gl.getShaderParameter(s,gl.COMPILE_STATUS))console.error(gl.getShaderInfoLog(s));return s}const program=gl.createProgram();gl.attachShader(program,shader(gl.VERTEX_SHADER,vs));gl.attachShader(program,shader(gl.FRAGMENT_SHADER,fs));gl.linkProgram(program);gl.useProgram(program);const buffer=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,buffer);gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,1,-1,-1,1,1,1]),gl.STATIC_DRAW);const pos=gl.getAttribLocation(program,'p');gl.enableVertexAttribArray(pos);gl.vertexAttribPointer(pos,2,gl.FLOAT,false,0,0);const time=gl.getUniformLocation(program,'time');const darkMode=gl.getUniformLocation(program,'darkMode');function size(){const d=Math.min(devicePixelRatio||1,2),w=canvas.clientWidth,h=canvas.clientHeight;if(canvas.width!==w*d||canvas.height!==h*d){canvas.width=w*d;canvas.height=h*d}gl.viewport(0,0,canvas.width,canvas.height)}new ResizeObserver(size).observe(canvas);size();const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;function render(ms){size();gl.uniform1f(time,reduce?0:ms*.001);gl.uniform1f(darkMode,document.documentElement.dataset.theme==='dark'?1:0);gl.drawArrays(gl.TRIANGLE_STRIP,0,4);if(!reduce)requestAnimationFrame(render)}requestAnimationFrame(render)})();
