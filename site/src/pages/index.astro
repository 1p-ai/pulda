---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const baseUrl = Astro.site ?? new URL(import.meta.env.PUBLIC_SITE_URL || 'https://www.puldaunion.com');
const canonicalUrl = new URL(Astro.url.pathname, baseUrl);
const socialImageUrl = new URL('/case/pulda-renewal/home-light-current.png', baseUrl);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '풀다',
  alternateName: '풀다',
  url: baseUrl.toString(),
  email: '1p@puldaunion.com',
};
---<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<script is:inline>
try{const stored=localStorage.getItem('pulda-theme');const theme=stored==='dark'||stored==='light'?stored:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.theme=theme;document.documentElement.style.colorScheme=theme}catch(error){}
</script>
<meta name="description" content="성가신 문제를 풀어내는 창의적인 특별함">
<title>풀다 | 어려움은 풀고,올바름을 향합니다.</title>
<link rel="canonical" href={canonicalUrl}>
<meta name="robots" content="index,follow,max-image-preview:large">
<meta property="og:type" content="website">
<meta property="og:locale" content="ko_KR">
<meta property="og:site_name" content="풀다">
<meta property="og:title" content="풀다 | 어려움은 풀고,올바름을 향합니다.">
<meta property="og:description" content="기술과 비즈니스 사이의 매듭을 풀어 사람이 이해하고 움직일 수 있는 디지털 경험을 만듭니다.">
<meta property="og:url" content={canonicalUrl}>
<meta property="og:image" content={socialImageUrl}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="풀다 | 어려움은 풀고,올바름을 향합니다.">
<meta name="twitter:description" content="기술과 비즈니스 사이의 매듭을 풀어 사람이 이해하고 움직일 수 있는 디지털 경험을 만듭니다.">
<meta name="twitter:image" content={socialImageUrl}>
<meta name="theme-color" content="#f4ead8" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#050914" media="(prefers-color-scheme: dark)">
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gowun+Dodum&family=Nanum+Brush+Script&family=Hanken+Grotesk:wght@400;600;700;800&family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@700&display=swap" rel="stylesheet">
<style>
@font-face{font-family:"Solmoe Kim Daegeon";src:url("/fonts/SolmoeKimDaegeon-Medium.woff") format("woff");font-weight:500;font-style:normal;font-display:swap}
:root{--hanji:#f4ead8;--hanji-rgb:244,234,216;--paper:#fbf4e7;--paper-rgb:251,244,231;--paper-deep:#e6d5b9;--ivory:var(--hanji);--navy:#13233a;--navy-rgb:19,35,58;--navy2:#1d304b;--red:#9f3a32;--red-rgb:159,58,50;--red-on-dark:#cf6b5a;--red-on-dark-rgb:207,107,90;--white:#fbf4e7;--line:rgba(var(--navy-rgb),.18);--tech-bg:#050914;--tech-panel:#0a1222;--tech-panel2:#101b30;--tech-red:#ff2d2d;--tech-red-rgb:255,45,45;--tech-orange:#ff9b3d;--tech-cyan:#7ddcff;--tech-white:#edf4ff;--max:1440px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background-color:var(--ivory);background-image:linear-gradient(rgba(var(--paper-rgb),.48),rgba(var(--hanji-rgb),.36)),url("/logo/hanji-background-full.webp");background-size:auto,cover;background-position:center top;background-repeat:no-repeat;background-attachment:fixed;color:var(--navy);font-family:"Hanken Grotesk","Noto Sans KR",sans-serif;line-height:1.6;overflow-x:hidden}body.menu-open{overflow:hidden}a:not(.button):not(.cta){color:inherit;text-decoration:none}button{font:inherit;color:inherit}h1,h2,h3,p{margin-top:0}.shell{width:min(100%,var(--max));margin:auto;padding-inline:var(--pad)}
.eyebrow{display:flex;align-items:center;gap:12px;margin:0 0 24px;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.eyebrow:before{content:"";width:7px;height:7px;background:var(--red);flex:none}
.hero{position:relative;min-height:100svh;display:grid;align-items:center;padding:170px 0 96px;border-bottom:1px solid var(--line);isolation:isolate;overflow:hidden;background-color:var(--ivory);background-image:linear-gradient(rgba(var(--paper-rgb),.16),rgba(var(--hanji-rgb),.18)),url("/logo/hanji-background-full.webp");background-size:auto,cover;background-position:center;background-repeat:no-repeat}
/* 2026-07-10: fixed header already overlays the home hero.
   The former 88px/72px shader inset left a visible band below the nav after page-head spacing work. */
.hero canvas{position:absolute;z-index:-2;inset:0;width:100%;height:100%;opacity:.88}.hero:after{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,rgba(var(--paper-rgb),.50) 0%,rgba(var(--hanji-rgb),.30) 36%,rgba(var(--hanji-rgb),.08) 58%,rgba(var(--hanji-rgb),0) 78%);pointer-events:none}.hero-copy{max-width:1000px}.tag{display:inline-block;margin-bottom:28px;padding:7px 10px;border:1px solid var(--red);color:var(--red);font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}h1{max-width:900px;margin-bottom:44px;font-family:"Solmoe Kim Daegeon","Noto Serif KR",serif;font-size:clamp(38px,4.8vw,68px);font-weight:500;line-height:1.3;letter-spacing:0;word-break:keep-all}h1 .red{color:var(--red)}.lead{max-width:590px;margin-bottom:40px;font-size:clamp(16px,1.4vw,20px);word-break:keep-all}.actions{display:flex;flex-wrap:wrap;gap:10px}.scroll{position:absolute;right:clamp(34px,5.4vw,86px);bottom:clamp(58px,7vh,84px);width:clamp(76px,7.8vw,116px);aspect-ratio:1632/2554;display:block;opacity:.78;filter:drop-shadow(0 10px 16px rgba(var(--navy-rgb),.10));animation:norigaeFloat 3s ease-in-out infinite}.scroll img{display:block;width:100%;height:100%;object-fit:contain}.scroll-body,.scroll-tassel{position:absolute;inset:0;display:block}.scroll:after{display:none}.scroll-body{clip-path:inset(0 0 43% 0)}.scroll-tassel{clip-path:inset(52% 0 0 0);transform-origin:50% 52%;animation:norigaeTassel 2.2s ease-in-out infinite}.scroll-label{position:absolute;right:clamp(10px,2.8vw,48px);bottom:clamp(58px,7vh,84px);writing-mode:vertical-rl;font-size:9px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:rgba(var(--navy-rgb),.46);white-space:nowrap;animation:norigaeFloat 3s ease-in-out infinite}@keyframes norigaeFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(9px)}}@keyframes norigaeTassel{0%,100%{transform:rotate(-1.8deg) translateY(0)}50%{transform:rotate(2.4deg) translateY(3px)}}@keyframes scrollChevron{0%,100%{opacity:.28;transform:translate(-50%,-3px) rotate(45deg)}45%{opacity:.82;transform:translate(-50%,7px) rotate(45deg)}}
section{padding-block:clamp(88px,11vw,160px)}.grid12{display:grid;grid-template-columns:repeat(12,1fr);gap:24px}.intro-title{grid-column:1/span 5}.intro-copy{grid-column:7/-1}.intro h2,.section-title,.intro-heading{margin:0;font-size:clamp(36px,4.4vw,64px);line-height:1.05;letter-spacing:0;word-break:keep-all}.intro-heading{font-family:"Solmoe Kim Daegeon","Noto Serif KR",serif;font-weight:500}.section-title{font-family:"Solmoe Kim Daegeon","Noto Serif KR",serif;font-weight:500;line-height:1.12}.intro-copy p{max-width:620px;margin-bottom:24px;font-size:18px;word-break:keep-all}p.since{position:relative;margin:48px 0 0;padding-top:28px;font-family:"Solmoe Kim Daegeon","Noto Serif KR",serif;font-size:clamp(18px,2vw,28px);font-weight:500;line-height:1;letter-spacing:0;word-break:keep-all;text-align:right;opacity:1;transform:none}p.since::before{content:"";position:absolute;left:0;top:0;width:100%;height:2px;background:var(--navy);transform:scaleX(0);transform-origin:left center;transition:transform 1.8s cubic-bezier(.22,1,.36,1)}p.since.visible::before{transform:scaleX(1)}p.since{transform:scale(.88);opacity:0;transition:transform 1.2s cubic-bezier(.22,1,.36,1) 1.8s,opacity .8s ease 1.8s}p.since.visible{transform:scale(1);opacity:1}
.partners{position:relative;padding-block:clamp(58px,7vw,104px);border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(var(--paper-rgb),.34)}.partner-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:28px}.partner-head p{max-width:430px;margin:0;color:rgba(var(--navy-rgb),.68);word-break:keep-all}.partner-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1px solid rgba(var(--navy-rgb),.18);background:rgba(var(--navy-rgb),.18)}.partner-logo{position:relative;min-height:118px;display:flex;align-items:center;justify-content:center;padding:26px 18px;background:rgba(var(--paper-rgb),.54);color:#111;font-size:clamp(18px,2.4vw,34px);font-weight:900;letter-spacing:.08em;text-transform:uppercase;filter:grayscale(1);overflow:hidden}.partner-logo:before{content:attr(data-trigram);position:absolute;left:14px;top:10px;color:rgba(17,17,17,.18);font-size:18px;letter-spacing:0}.partner-logo:after{content:"";position:absolute;left:18%;right:18%;bottom:18px;height:2px;background:#111;opacity:.22;transform:rotate(-1deg)}.partner-logo span{position:relative;z-index:1;text-align:center;line-height:1}.partner-note{margin:18px 0 0;color:rgba(var(--navy-rgb),.58);font-size:13px}.partner-note strong{color:var(--red)}.services{--red:var(--red-on-dark);--red-rgb:var(--red-on-dark-rgb);background:var(--navy);color:var(--white)}.section-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:64px}.section-head>p{max-width:430px;margin:0}.service-list{border-top:1px solid rgba(var(--paper-rgb),.22)}.service{display:grid;grid-template-columns:80px 1fr 1fr 48px;gap:24px;align-items:center;min-height:150px;border-bottom:1px solid rgba(var(--paper-rgb),.22);transition:.25s}.service:hover{padding-inline:20px;background:var(--navy2)}.num{color:var(--red);font-size:13px;font-weight:700}.service h3{margin:0;font-size:clamp(26px,3vw,42px);line-height:1.1}.service p{max-width:480px;margin:0;color:#cbd2de}.service .arrow{color:var(--red);font-size:30px}
/* 2026-07-06: home IA now prioritizes curated proof, story cues, and contact conversion.
   Partner marks moved from intro-adjacent branding to project/trust context. */
.work-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:56px}.work-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:24px}.project{position:relative;min-height:580px;overflow:hidden;background:#d8d0c2;color:var(--white)}.visual{position:absolute;inset:0;transition:transform .6s}.project:hover .visual{transform:scale(1.035)}.visual-a{background:linear-gradient(115deg,rgba(var(--navy-rgb),.92) 0 38%,transparent 38%),repeating-linear-gradient(90deg,transparent 0 10%,rgba(var(--red-rgb),.18) 10% 10.3%),linear-gradient(135deg,var(--paper),#8795a5)}.visual-a:before{content:"A4U.KR";position:absolute;right:7%;top:18%;color:var(--navy);font-size:clamp(48px,7vw,100px);font-weight:800}.visual-a:after{content:"";position:absolute;right:8%;bottom:12%;width:42%;aspect-ratio:16/10;border:12px solid var(--navy);background:linear-gradient(90deg,transparent 49%,var(--red) 49% 51%,transparent 51%),linear-gradient(var(--paper) 49%,var(--navy) 49% 52%,var(--paper) 52%)}.visual-b{background-image:linear-gradient(180deg,rgba(var(--navy-rgb),.05),rgba(var(--navy-rgb),.38)),url("/case/eunjo-imweb/portfolio-anchor-frame.png");background-size:cover;background-position:top center}.visual-c{background-image:linear-gradient(180deg,rgba(var(--navy-rgb),.08),rgba(var(--navy-rgb),.46)),url("/case/pulda-renewal/home-light.png");background-size:cover;background-position:top center}/* 2026-07-17: Pulda OS has no approved product capture yet; keep the existing two cards intact and use a code-native system field for the third featured card. */.visual-d{background:radial-gradient(circle at 72% 26%,rgba(var(--red-rgb),.34),transparent 22%),linear-gradient(rgba(var(--paper-rgb),.12) 1px,transparent 1px),linear-gradient(90deg,rgba(var(--paper-rgb),.1) 1px,transparent 1px),linear-gradient(135deg,var(--navy),var(--navy2));background-size:auto,36px 36px,36px 36px,auto}.visual-d:before{content:"EVENT → DECISION → ACTION → RESULT";position:absolute;inset:18% 8% auto;color:rgba(var(--paper-rgb),.76);font-size:clamp(18px,2.2vw,34px);font-weight:800;line-height:1.4;letter-spacing:.08em}.project-info{position:absolute;inset:auto 0 0;padding:32px;background:linear-gradient(transparent,rgba(var(--navy-rgb),.96))}.project-info .eyebrow{margin-bottom:12px}.project-info h3{margin-bottom:4px;font-size:32px}.project-info p{margin:0;color:#d9dfeb}.project-status{display:inline-flex;margin:0 0 12px;padding:6px 9px;border:1px solid rgba(var(--paper-rgb),.72);background:rgba(var(--navy-rgb),.62);color:var(--paper);font-size:11px;font-weight:800;letter-spacing:.08em}.story-preview{padding-block:clamp(78px,9vw,128px);border-top:1px solid var(--line)}.story-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:24px}.story-card{display:block;border-top:1px solid var(--line);padding:28px 0}.story-card h3{margin:0 0 10px;font-size:clamp(26px,3vw,42px);line-height:1.14;word-break:keep-all}.story-card p{max-width:560px;margin:0 0 18px;color:rgba(var(--navy-rgb),.72);word-break:keep-all}.story-card .meta{color:var(--red);font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.trust-band{padding-block:clamp(72px,8vw,118px);border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(var(--paper-rgb),.38)}.trust-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.trust-grid div{min-height:158px;padding:28px;background:rgba(var(--paper-rgb),.7)}.trust-grid strong{display:block;margin-bottom:10px;color:var(--red);font-size:clamp(32px,4vw,58px);line-height:1}.trust-grid span{font-size:15px;word-break:keep-all}
.visual-a{background-image:linear-gradient(180deg,rgba(var(--navy-rgb),.04),rgba(var(--navy-rgb),.58)),url("/case/a4u-platform/apply4u-origin.jpg");background-size:cover;background-position:top center}.visual-a:before,.visual-a:after{display:none}
.contact{position:relative;padding-block:clamp(96px,13vw,184px);color:var(--white);background:linear-gradient(135deg,var(--red),#823028);overflow:hidden}.contact:after{content:"";position:absolute;right:clamp(-34px,-1.8vw,-12px);bottom:clamp(34px,7vw,112px);width:clamp(360px,30vw,620px);aspect-ratio:1.7/1;background:rgba(var(--paper-rgb),.13);-webkit-mask:url("/logo/pulda-logo-red.webp") center/contain no-repeat;mask:url("/logo/pulda-logo-red.webp") center/contain no-repeat;pointer-events:none}.contact .eyebrow:before{background:var(--white)}.contact h2{max-width:1000px;margin-bottom:48px;font-family:"Solmoe Kim Daegeon","Noto Serif KR",serif;font-size:clamp(48px,7vw,98px);font-weight:500;line-height:1.12;letter-spacing:0;word-break:keep-all}.contact .button{position:relative;z-index:1;border-color:var(--white);background:var(--white);color:var(--red)}.contact .button:hover{border-color:var(--navy);background:var(--navy);color:var(--white)}
footer{padding:56px 0 32px;color:var(--white);background:var(--navy)}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:32px;margin-bottom:64px}footer .logo{width:88px;height:70px;margin-bottom:18px}footer h3{margin-bottom:14px;color:#8791a2;font-size:10px;letter-spacing:.14em;text-transform:uppercase}footer p,footer a{font-size:13px;color:#d5dbe5}footer a{display:block;margin-bottom:7px}.copyright{display:flex;justify-content:space-between;padding-top:24px;border-top:1px solid rgba(var(--paper-rgb),.16);color:#8791a2;font-size:11px}.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s,transform .7s}.reveal.visible{opacity:1;transform:none}:focus-visible{outline:3px solid var(--red);outline-offset:4px}
.light-copy{display:inline}.dark-copy{display:none}.nav-links>a:not(.cta) .light-copy{font-family:"Solmoe Kim Daegeon","Noto Serif KR",serif;font-size:19px;font-weight:500}.theme-switch{display:grid;grid-template-columns:30px 30px;height:32px;border:1px solid var(--line)}.theme-switch button{width:30px;height:30px;padding:0;border:0;border-left:1px solid var(--line);background:transparent;color:var(--navy);font-family:"Solmoe Kim Daegeon",serif;font-size:17px;line-height:30px;cursor:pointer}.theme-switch button:first-child{border-left:0}.theme-switch button[aria-pressed="true"]{background:var(--red);color:var(--white)}.theme-switch button:focus-visible{outline-offset:2px}

.dark-logo,.dark-hero-title{display:none}
html[data-theme="dark"] .story-card p,html[data-theme="dark"] .trust-grid span{color:rgba(237,244,255,.68)}html[data-theme="dark"] .trust-band{background:rgba(237,244,255,.04)}html[data-theme="dark"] .trust-grid{background:rgba(237,244,255,.14);border-color:rgba(237,244,255,.14)}html[data-theme="dark"] .trust-grid div{background:rgba(237,244,255,.045)}html[data-theme="dark"] .visual-c{background-image:linear-gradient(180deg,rgba(5,9,20,.1),rgba(5,9,20,.56)),url("/case/pulda-renewal/home-dark.png")}
